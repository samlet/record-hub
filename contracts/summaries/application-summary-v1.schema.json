{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:record-hub:summary:application:v1",
  "title": "Approver ApplicationSummary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["applicationId", "title", "status", "processRef", "updatedAt", "version"],
  "properties": {
    "applicationId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "status": { "type": "string", "minLength": 1, "maxLength": 64 },
    "processRef": { "type": "string", "minLength": 1, "maxLength": 256 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 }
  }
}
