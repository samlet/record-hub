{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:record-hub:summary:approval:v1",
  "title": "Fluxion dispatch approval association summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["applicationRef", "projectRef", "status", "workflowRef", "proposalHash", "dispatchGeneration", "decisionVersion", "freshness", "updatedAt", "version"],
  "properties": {
    "applicationRef": { "type": "string", "pattern": "^approver:APPLICATION:[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$" },
    "projectRef": { "type": "string", "pattern": "^fluxion:PROJECT:[0-9a-fA-F-]{36}$" },
    "status": { "enum": ["PENDING", "APPROVED", "REJECTED", "WITHDRAWN", "CANCELLED", "EXPIRED", "FAILED"] },
    "workflowRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowId", "runId"],
      "properties": {
        "workflowId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "runId": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "proposalHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "dispatchGeneration": { "type": "integer", "minimum": 1 },
    "decisionVersion": { "type": "integer", "minimum": 1 },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceEventId", "sourceVersion", "observedAt"],
      "properties": {
        "sourceEventId": { "type": "string", "pattern": "^apr-result-[a-z0-9-]{8,128}$" },
        "sourceVersion": { "type": "integer", "minimum": 1 },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "updatedAt": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 }
  }
}
