{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:record-hub:dispatch-approval-request:v1",
  "title": "Fluxion dispatch approval request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventType",
    "schemaVersion",
    "externalRequestId",
    "tenantId",
    "workspaceId",
    "externalScope",
    "resourceRef",
    "resourceVersion",
    "dispatchGeneration",
    "proposalHash",
    "snapshotHash",
    "workflow",
    "requester",
    "proposal"
  ],
  "properties": {
    "eventType": { "const": "fluxion.dispatch-approval.requested" },
    "schemaVersion": { "const": 1 },
    "externalRequestId": { "type": "string", "pattern": "^apr-[a-z0-9-]{8,128}$" },
    "tenantId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$" },
    "workspaceId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$" },
    "externalScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "ORGANIZATION" },
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$" }
      }
    },
    "resourceRef": { "type": "string", "pattern": "^fluxion:PROJECT:[0-9a-fA-F-]{36}$" },
    "resourceVersion": { "type": "integer", "minimum": 1 },
    "dispatchGeneration": { "type": "integer", "minimum": 1 },
    "proposalHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "snapshotHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowId", "runId"],
      "properties": {
        "workflowId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "runId": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuerAlias", "subject"],
      "properties": {
        "issuerAlias": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$" },
        "subject": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workerRef", "skill", "scheduledDate"],
      "properties": {
        "workerRef": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$" },
        "skill": { "type": "string", "minLength": 1, "maxLength": 64 },
        "scheduledDate": { "type": "string", "format": "date" }
      }
    }
  }
}
