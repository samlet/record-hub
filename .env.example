# Required: api, worker, or all.
RECORD_HUB_MODE=all

# Required in api and all modes.
RECORD_HUB_HTTP_ADDRESS=127.0.0.1:8080

# Optional runtime controls.
RECORD_HUB_LOG_LEVEL=info
RECORD_HUB_SHUTDOWN_TIMEOUT=10s

# Optional native/runtime data plane. When set, API handlers use MongoDB
# repositories; setting NATS_URL as well enables the three durable projection
# workers in worker/all mode.
RECORD_HUB_MONGODB_URI='mongodb://127.0.0.1:27017/record_hub?replicaSet=rs0&directConnection=true'
RECORD_HUB_MONGODB_DATABASE=record_hub
RECORD_HUB_NATS_URL=nats://127.0.0.1:4222
# Events without metadata.workspaceId are rejected unless this explicit local
# fallback is set. Prefer adding workspaceId metadata in new producers.
RECORD_HUB_PROJECTION_WORKSPACE_ID=workspace-local
# Optional legacy-event scope map, as a JSON object. Event metadata.workspaceId
# takes precedence, then this tenant mapping, then the local fallback above.
# RECORD_HUB_PROJECTION_WORKSPACE_MAP='{"default":"workspace-local"}'

# Optional bearer-token boundary for API/service clients. Browser/BFF OIDC
# remains configured independently below.
# RECORD_HUB_OIDC_ISSUER=https://dex.example.com
# RECORD_HUB_OIDC_AUDIENCE=record-hub-api
# RECORD_HUB_OIDC_PRINCIPAL_KIND=user
# RECORD_HUB_OIDC_ALLOW_INSECURE_ISSUER=false

# Optional browser/BFF OIDC boundary. Keep disabled for API-only deployments.
# Local Dex uses HTTP; set both insecure flags only for local development.
RECORD_HUB_WEB_ENABLED=false
RECORD_HUB_WEB_ISSUER=http://127.0.0.1:5556/dex
RECORD_HUB_WEB_AUDIENCE=record-hub-web-local
RECORD_HUB_WEB_AUTHORIZATION_ENDPOINT=http://127.0.0.1:5556/dex/auth
RECORD_HUB_WEB_TOKEN_ENDPOINT=http://127.0.0.1:5556/dex/token
RECORD_HUB_WEB_CLIENT_ID=record-hub-web-local
RECORD_HUB_WEB_CLIENT_SECRET=<from deploy/local/dex/.env.local>
# Match the exact callback owned by the BFF. Use :8080 when the Go API mounts
# server/internal/web directly; use :3004 only when a separate Web BFF owns it.
RECORD_HUB_WEB_REDIRECT_URL=http://127.0.0.1:8080/auth/callback
RECORD_HUB_WEB_SUCCESS_REDIRECT_URL=/
RECORD_HUB_WEB_POST_LOGOUT_REDIRECT_URL=/
RECORD_HUB_WEB_SCOPE=openid profile email
RECORD_HUB_WEB_SESSION_SECRET=<at-least-32-random-bytes>
RECORD_HUB_WEB_SESSION_TTL=8h
RECORD_HUB_WEB_SECURE_COOKIES=false
RECORD_HUB_WEB_ALLOW_INSECURE_ENDPOINTS=true
