  "backpressure": {"maxInFlight": 100, "retryAfterSeconds": 5, "overloadAction": "PAUSE_AND_AUDIT"},
  "liveEvidenceRequired": true,
  "missingAction": "BLOCKED_BY_LIVE_EVENT_EVIDENCE",
