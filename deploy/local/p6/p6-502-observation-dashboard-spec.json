    "lagAgeSeconds": {"warning": 30, "critical": 300},
    "deadCount": {"warning": 1, "critical": 10},
    "findingCount": {"warning": 1, "critical": 10}
  },
  "access": {
    "readRoles": ["OPERATOR", "OWNER"],
    "mutations": "NONE",
    "auditExport": "REQUIRED"
  },
  "missingAction": "BLOCKED_BY_OBSERVABILITY_GAP",
  "prerequisite": {
    "phase5": "INDEPENDENT_GATE",
    "connectorEnablement": "NOT_GRANTED"
  }
